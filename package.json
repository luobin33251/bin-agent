{
  "name": "bin-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "通用个人信息中枢：对话录入，AI 自主归类，对话调取",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "pnpm --filter @bin/server dev",
    "dev:web": "pnpm --filter @bin/web dev",
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter './packages/*' build",
    "build:web": "pnpm --filter @bin/web build",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css}\"",
    "reindex": "pnpm --filter @bin/server reindex",
    "clean": "pnpm -r exec node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}