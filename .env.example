# ==================== 服务配置 ====================
PORT=3100
HOST=0.0.0.0
NODE_ENV=development

# ==================== 对话模型（OpenAI 兼容接口）====================
# 接口地址。默认指向阿里云百炼 MaaS 的兼容模式端点
LLM_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your_api_key
LLM_MODEL=deepseek-v4-flash
# 单次回复最大 token（留空使用模型默认值）
LLM_MAX_TOKENS=
# 采样温度
LLM_TEMPERATURE=0.3

# ==================== 向量模型（语义检索）====================
# 与对话模型分开配置，不再回落。EMBED_API_KEY 留空 = 语义检索关闭，检索退化为纯关键词。
# 默认端点是阿里云百炼 DashScope，模型 text-embedding-v4（1024 维）。
# 这里的 Key 必须是百炼控制台开的 sk- 开头 API-KEY，不能用只跑对话的套餐 key。
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_API_KEY=
EMBED_MODEL=text-embedding-v4
EMBED_DIM=1024

# ==================== 数据存储 ====================
# SQLite 主库文件（相对项目根目录）
DB_FILE=./data/bin.db

# ==================== 安全配置 ====================
CORS_ORIGIN=http://localhost:5173